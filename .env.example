# LLM provider 配置 —— 真实 .env 不入 git，这份 .env.example 入 git 作模板

# 任何 OpenAI 兼容的 endpoint：
#   - https://api.openai.com/v1
#   - https://api.deepseek.com/v1
#   - https://api.anthropic.com/v1  (via proxy)
#   - https://sz.uyilink.com/v1  (中转聚合器示例)
LLM_BASE_URL=https://api.deepseek.com/v1

# API key
LLM_API_KEY=sk-your-key-here

# 模型名 —— 根据 provider 不同：deepseek-chat / gpt-4o-mini / claude-3-haiku 等
LLM_MODEL=deepseek-chat
