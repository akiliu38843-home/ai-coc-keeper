{
  "name": "ai-coc-keeper",
  "version": "0.0.1",
  "description": "AI-powered Keeper for solo Call of Cthulhu-style scenarios with galgame UI",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "node --env-file=.env --import tsx scripts/console-demo.ts",
    "parse": "node --env-file=.env --import tsx scripts/parse-scenario.ts",
    "parse:multi": "node --env-file=.env --import tsx scripts/parse-scenario-multi.ts",
    "build:webgal": "node --import tsx scripts/build-webgal-game.ts",
    "gen:ai-game": "node --env-file=.env --import tsx scripts/generate-ai-game.ts",
    "create:character": "node --import tsx scripts/create-character.ts",
    "build:dist": "cd external/WebGAL && yarn build && cd ../.. && echo '✅ dist 在 external/WebGAL/packages/webgal/dist/'",
    "serve:dist": "python3 -m http.server 4300 --directory external/WebGAL/packages/webgal/dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "dependencies": {
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.7.284",
    "unpdf": "^1.6.2"
  }
}
