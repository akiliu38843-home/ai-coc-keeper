{
  "name": "ai-coc-keeper",
  "version": "0.0.1",
  "description": "AI-powered Keeper for solo Call of Cthulhu-style scenarios with galgame UI",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "demo": "node --env-file=.env --import tsx scripts/console-demo.ts",
    "parse": "node --env-file=.env --import tsx scripts/parse-scenario.ts",
    "parse:multi": "node --env-file=.env --import tsx scripts/parse-scenario-multi.ts",
    "parse:text": "node --env-file=.env --import tsx scripts/parse-text.ts",
    "build:test": "node --import tsx scripts/build-test-scenario.ts",
    "build:kohaku-v3": "node --import tsx scripts/build-kohaku-v3.ts",
    "polish:kohaku-v3": "node --env-file=.env --import tsx scripts/polish-kohaku-v3-expansions.ts",
    "gen:kohaku-v3-scenario": "node --import tsx scripts/generate-kohaku-v3-scenario.ts",
    "build:webgal": "node --import tsx scripts/build-webgal-game.ts",
    "gen:ai-game": "node --env-file=.env --import tsx scripts/generate-ai-game.ts",
    "create:character": "node --import tsx scripts/create-character.ts",
    "build:dist": "cd external/WebGAL && yarn build && cd ../.. && node --import tsx scripts/post-build.ts",
    "serve:dist": "python3 -m http.server 4300 --directory external/WebGAL/packages/webgal/dist",
    "deploy:prep": "bash scripts/prepare-deploy.sh",
    "build:launcher": "node --import tsx scripts/build-launcher.ts",
    "server:live": "node --env-file=.env --import tsx src/server/game-server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "dependencies": {
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.7.284",
    "unpdf": "^1.6.2"
  }
}
